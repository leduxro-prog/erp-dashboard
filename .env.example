# ============================================
# CYPHER ERP — Environment Configuration
# ============================================
# Copy this file to .env and fill in values

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=CYPHER ERP
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Production override example:
# APP_URL=https://api.ledux.ro
# FRONTEND_URL=https://ledux.ro
# PUBLIC_BASE_URL=https://api.ledux.ro
# COOKIE_DOMAIN=.ledux.ro
# COOKIE_SECURE=true

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cypher_erp
DB_USER=cypher_user
DB_PASSWORD=cypher_secret_change_me
DB_SSL=false
DB_LOGGING=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me
REDIS_DB=0

# --- MeiliSearch (Search Engine) ---
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# --- JWT Authentication ---
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_SECRET_FILE=/app/config/secrets/jwt_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_change_me
JWT_REFRESH_SECRET_FILE=/app/config/secrets/jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# B2B specific JWT configuration
JWT_SECRET_B2B=your_b2b_jwt_secret_change_me
JWT_REFRESH_SECRET_B2B=your_b2b_refresh_secret_change_me
JWT_SECRET_B2B_FILE=/app/config/secrets/jwt_secret_b2b
JWT_REFRESH_SECRET_B2B_FILE=/app/config/secrets/jwt_refresh_secret_b2b
JWT_B2B_EXPIRES_IN=15m
JWT_B2B_REFRESH_EXPIRES_IN=7d

# --- SmartBill API ---
SMARTBILL_API_URL=https://ws.smartbill.ro/SMBWS/api
SMARTBILL_USERNAME=
SMARTBILL_TOKEN=
SMARTBILL_COMPANY_VAT=
SMARTBILL_INVOICE_SERIES=FL
SMARTBILL_SYNC_INTERVAL_MS=900000

# --- WooCommerce API ---
WOOCOMMERCE_URL=https://ledux.ro
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_VERSION=wc/v3

# --- WhatsApp Business (Agent B) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Evolution API (WhatsApp sessions) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=
EVOLUTION_INSTANCE_SALES=wa-sales
EVOLUTION_INSTANCE_SUPPORT=wa-support
EVOLUTION_NUMBER_SALES=40752427978
EVOLUTION_NUMBER_SUPPORT=40772076879

# --- AI assistant for WhatsApp bot ---
AI_SERVICE_URL=http://ai-service:8000
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=/app/config/secrets/gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=/app/config/secrets/openrouter_api_key
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_APP_URL=https://erp.ledux.ro
OPENROUTER_APP_TITLE=Cypher ERP WhatsApp Bot
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=15000
BOT_METRICS_LOG_EVERY=20
BOT_CONTEXT_MESSAGES=20
BOT_KNOWLEDGE_FILE=/app/config/bot_knowledge.json
BOT_MARKET_SIGNALS_FILE=/app/config/market_signals.json
BOT_MARKET_SIGNALS_CRON=15 2 * * *
BOT_KNOWLEDGE_SYNC_HOURS=24
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=
MARKETING_GSC_SYNC_CRON=25 2 * * *
MARKETING_WP_AUTO_PUBLISH_ENABLED=true
MARKETING_WP_AUTO_PUBLISH_CRON=55 2 * * *
MARKETING_WP_AUTO_PUBLISH_DAILY_LIMIT=2
MARKETING_WP_AUTO_PUBLISH_MIN_SCORE=35
MARKETING_WP_AUTO_PUBLISH_PER_CATEGORY_LIMIT=1
WP_SITE_URL=https://ledux.ro
WP_APP_USER=
WP_APP_PASSWORD_FILE=/app/config/secrets/wp_app_password
WP_ADMIN_USER=
WP_ADMIN_PASSWORD_FILE=/app/config/secrets/wp_admin_password

# --- Feature Flags ---
FEATURE_ENABLE_WHATSAPP_MODULE=true

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ledux.ro
EMAIL_FROM_NAME=Ledux.ro

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_API_KEY_FILE=/app/config/secrets/resend_api_key

# --- Supplier Scraping ---
SUPPLIER_SYNC_INTERVAL_MS=14400000
SUPPLIER_SCRAPE_TIMEOUT_MS=30000
SUPPLIER_SCRAPE_MAX_RETRIES=3
SUPPLIER_MONITOR_TARGET_CODE=aca-lighting
SUPPLIER_MONITOR_MIN_PRODUCTS=1000
SUPPLIER_MONITOR_MIN_SPEC_COVERAGE_PCT=45

# --- Innpro IOF Integration ---
INNPRO_IOF_GATEWAY_URL=
INNPRO_IOF_TOKEN=
INNPRO_B2B_LOGIN=
INNPRO_B2B_PASSWORD=
INNPRO_DEFAULT_MARKUP=60

# --- Example Supplier API Connector ---
SAMPLE_SUPPLIER_API_ENDPOINT=
SAMPLE_SUPPLIER_MAX_PAGES=10
SAMPLE_SUPPLIER_PAGE_SIZE=200
SAMPLE_SUPPLIER_TIMEOUT_MS=30000

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=combined

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
ALLOW_LOCALHOST_ORIGINS=false

# Production CORS example:
# CORS_ORIGINS=https://ledux.ro,https://www.ledux.ro,https://erp.ledux.ro,https://b2b.ledux.ro,https://api.ledux.ro
# ALLOW_LOCALHOST_ORIGINS=true  # Use only for local QA when NODE_ENV=production

# --- Docker & Container Orchestration ---
DOCKER_REGISTRY=your-registry.azurecr.io
DOCKER_IMAGE_NAME=cypher-erp
DOCKER_IMAGE_TAG=latest
CONTAINER_PORT=3000

# --- PgAdmin (Optional Database Management) ---
PGADMIN_EMAIL=admin@ledux.ro
PGADMIN_PASSWORD=pgadmin_password_change_me

# --- CI/CD Configuration ---
CI_REGISTRY_USER=
CI_REGISTRY_PASSWORD=
GITHUB_TOKEN=
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# --- Slack Notifications ---
SLACK_WEBHOOK=
SLACK_CHANNEL=#deployments

# --- Monitoring & Logging ---
SENTRY_DSN=
DATADOG_API_KEY=
NEWRELIC_LICENSE_KEY=

# --- Feature Flags ---
FEATURE_ADVANCED_REPORTING=true
FEATURE_AI_RECOMMENDATIONS=false
FEATURE_MULTI_CURRENCY=true

# --- Server-side Tracking (GA4 MP + Meta CAPI) ---
SERVER_TRACKING_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional: use only for Meta Events Manager test mode
META_TEST_EVENT_CODE=
