# Browser app environment example
# Local Vite dev: VITE_API_URL=http://localhost:8000/api/v1
# Local docker compose frontend: VITE_API_URL=http://localhost:3000/api/v1
# Non-local deployments should point to the explicit API host for that intent.
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=CYPHER ERP
VITE_APP_VERSION=1.0.0
